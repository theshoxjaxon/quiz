# Copy to .env.local and set a real password:  cp .env.example .env.local
# The teacher logs in to /admin with any username and this password.
ADMIN_PASSWORD=change-me

# Turso (libSQL) database. Leave both empty for local development: the app then uses the file quiz.db.
# For a Vercel deploy, set them in the Vercel project settings instead of here. Anything in .env.local
# also applies to `npm run dev`, `npm run setup` and `npm run db:reset` on this computer.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
