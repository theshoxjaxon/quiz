# Copy to .env.local and fill in:  cp .env.example .env.local

# The teacher logs in to /admin with any username and this password.
ADMIN_PASSWORD=change-me

# Postgres connection string from Supabase: project → Connect → "Transaction pooler" (port 6543).
# Use a separate free Supabase project for development; put the production one only in Vercel.
# Replace [YOUR-PASSWORD] with the database password (URL-encode special characters like @ # / ?).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
